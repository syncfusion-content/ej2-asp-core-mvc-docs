<div style="display: flex; padding-bottom: 20px">
    <label style="padding: 5px 10px 0 0">Empty Record Mode:</label>
    @Html.EJS().DropDownList("dropdown").DataSource(@ViewBag.dropdownData).Index(0).Width("100px").Change("onModeChange").Render()
</div>
@Html.EJS().Grid("Grid").DataSource((IEnumerable<object>)ViewBag.DataSource).EmptyRecordMode("Sticky").Columns(col =>
{
    col.Field("OrderID").HeaderText("Order ID").IsPrimaryKey(true).TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).ValidationRules(new { required = true, number = true }).Width("140").Add();
    col.Field("CustomerID").HeaderText("Customer ID").ValidationRules(new { required = true }).Width("140").Add();
    col.Field("Freight").HeaderText("Freight").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).EditType("numericedit").Format("C2").ValidationRules(new { required = true }).Width("140").Add();
    col.Field("OrderDate").HeaderText("Order Date").EditType("datepickeredit").Format("yMd").Width("160").Add();
    col.Field("ShipCountry").HeaderText("Ship Country").Width("150").Add();
    col.Field("ShipCity").HeaderText("Ship City").Width("150").Add();
    col.Field("ShipAddress").HeaderText("Ship Address").Width("200").Add();
}).EditSettings(edit => { edit.AllowEditing(true).AllowAdding(true).AllowDeleting(true); }).Toolbar(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" }).Render()
<script>
    function onModeChange(args) {
        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.emptyRecordMode = args.value;
    }
</script>