@Html.EJS().Grid("Grid").DataSource((IEnumerable<object>)ViewBag.DataSource).AllowSorting(true).AllowFiltering(true).Height("273").Columns(col =>
{
   col.Type("RowNumber").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).Add();
   col.Field("ProductID").HeaderText("Product ID").Width("120").Visible(false).TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).IsPrimaryKey(true).Type("number").Add();
   col.Field("ProductName").HeaderText("Products").Width("160").AllowEditing(false).Add();
   col.Field("Category").HeaderText("Category").Width("140").AllowEditing(false).Add();
   col.Field("SellingPrice").HeaderText("Price").Width("130").Format("C").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
   col.Field("AvailableStock").HeaderText("In-Stock").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Template("#availableStockTemplate").Add();
   col.Field("SoldStock").HeaderText("Sold").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Template("#soldStockTemplate").Add();
}).Render()
<script type="text/x-template" id="availableStockTemplate">
   <span>${AvailableStock} ${Unit}</span>
</script>
<script type="text/x-template" id="soldStockTemplate">
   <span>${SoldStock} ${Unit}</span>
</script>