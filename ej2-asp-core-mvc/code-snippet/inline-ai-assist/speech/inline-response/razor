@using Syncfusion.EJ2.InteractiveChat

<div id="targetContent" contenteditable="true">
    <p>Select this content and use the microphone to provide instructions for an inline response.</p>
</div>

@Html.EJS().InlineAIAssist("inlinePrompt")
    .RelateTo("#targetContent")
    .ResponseMode(Syncfusion.EJ2.InteractiveChat.ResponseMode.Inline)
    .SpeechToTextSettings(new InlineAIAssistSpeechToTextSettings { Enable = true })
    .ResponseSettings(new InlineAIAssistResponseSettings { ItemSelect = "onResponseItemSelect" })
    .PromptRequest("onPromptRequest")
    .Render()

<script>
    function onPromptRequest(args) {
        var inlineAssist = this;
        setTimeout(function () {
            inlineAssist.addResponse('This response was generated from the selected content and spoken prompt.');
        }, 500);
    }

    function onResponseItemSelect(args) {
        if (args.command.label === 'Accept' || args.command.label === 'Discard') {
            this.hidePopup();
        }
    }
</script>
