<div class="control-section">
    <div id="control-container">
        <ejs-stockchart
            id="container"
            width="1100px"
            height="455px"
            title="Live Stock Data"
            theme="Material"
            load="stockLoad"
            loaded="stockLoaded"
            seriesType="@(new List<object>())"
            indicatorType="@(new List<object>())"
            trendlineType="@(new List<object>())"
            enableCustomRange="false">

            <e-stockchart-primaryxaxis
                valueType="@Syncfusion.EJ2.Charts.ValueType.DateTime"
                labelFormat="HH:mm">
            </e-stockchart-primaryxaxis>

            <e-stockchart-primaryyaxis
                labelPosition="@Syncfusion.EJ2.Charts.AxisPosition.Outside">
            </e-stockchart-primaryyaxis>

            <e-stockchart-chartarea>
                <e-stockchart-chartarea-border width="0">
                </e-stockchart-chartarea-border>
            </e-stockchart-chartarea>

            <e-stockchart-series-collection>
                <e-stockchart-series
                    type="@ChartSeriesType.Candle"
                    xName="x"
                    open="open"
                    high="high"
                    low="low"
                    close="close"
                    volume="volume">
                </e-stockchart-series>
            </e-stockchart-series-collection>

            <e-stockchart-periods>
                <e-stockchart-period
                    text="1H"
                    interval="1"
                    intervalType="@RangeIntervalType.Hours"
                    selected="true">
                </e-stockchart-period>

                <e-stockchart-period text="All">
                </e-stockchart-period>
            </e-stockchart-periods>
        </ejs-stockchart>
    </div>
</div>

<script>
    /**
     * Simulated one-minute candle in milliseconds.
     */
    var ONE_MINUTE_MS = 60 * 1000;

    /**
     * Tick frequency for updating the chart.
     * In a real application, this would be approximately 60000 milliseconds.
     * For demonstration purposes, it is 100 milliseconds.
     */
    var UPDATE_INTERVAL_MS = 100;

    /**
     * A new one-minute candle is added after every ten updates.
     */
    var UPDATES_PER_CANDLE = 10;

    /**
     * Animation is disabled while updating the current candle.
     */
    var UPDATE_ANIMATION_DURATION = 0;

    /**
     * Short animation when adding a new candle.
     */
    var ADD_ANIMATION_DURATION = 300;

    /**
     * Number of initial historical candles.
     */
    var INITIAL_CANDLE_COUNT = 120;

    /**
     * Initial stock price.
     */
    var INITIAL_PRICE = 375;

    var stockChart = null;
    var stockData = [];
    var updateTimer = null;
    var updateIndex = 0;

    /**
     * Returns a random number between the specified minimum
     * and maximum values.
     */
    function randomBetween(minimum, maximum) {
        return minimum + Math.random() * (maximum - minimum);
    }

    /**
     * Rounds the specified value to two decimal places.
     */
    function correctFloat(value) {
        return Number(value.toFixed(2));
    }

    /**
     * Returns the timestamp representing the beginning
     * of the current minute.
     */
    function getCurrentMinute() {
        return Math.floor(Date.now() / ONE_MINUTE_MS) *
            ONE_MINUTE_MS;
    }

    /**
     * Creates a historical OHLCV candle.
     */
    function createHistoricalCandle(timestamp, openingPrice) {
        var movement = randomBetween(-1.5, 1.5);

        var close = correctFloat(
            Math.max(1, openingPrice + movement)
        );

        var high = correctFloat(
            Math.max(openingPrice, close) +
            randomBetween(0.05, 0.7)
        );

        var low = correctFloat(
            Math.max(
                1,
                Math.min(openingPrice, close) -
                randomBetween(0.05, 0.7)
            )
        );

        return {
            x: new Date(timestamp),
            open: correctFloat(openingPrice),
            high: high,
            low: low,
            close: close,
            volume: Math.round(
                randomBetween(1000, 5000)
            )
        };
    }

    /**
     * Creates the initial historical stock data.
     */
    function createInitialLocalData() {
        var currentMinute = getCurrentMinute();

        var startingTime =
            currentMinute -
            (INITIAL_CANDLE_COUNT - 1) * ONE_MINUTE_MS;

        var price = INITIAL_PRICE;

        stockData = [];

        for (
            var index = 0;
            index < INITIAL_CANDLE_COUNT;
            index++
        ) {
            var timestamp =
                startingTime + index * ONE_MINUTE_MS;

            var candle =
                createHistoricalCandle(
                    timestamp,
                    price
                );

            stockData.push(candle);
            price = candle.close;
        }
    }

    /**
     * Returns the StockSeries instance that exposes
     * the setData and addPoint methods.
     */
    function getCandleSeries() {
        if (
            stockChart &&
            stockChart.series &&
            stockChart.series.length &&
            typeof stockChart.series[0].setData === 'function' &&
            typeof stockChart.series[0].addPoint === 'function'
        ) {
            return stockChart.series[0];
        }

        return null;
    }

    /**
     * Creates an updated version of the currently forming candle.
     * The timestamp and opening price remain unchanged.
     */
    function createUpdatedCandle(currentCandle) {
        var movement = correctFloat(
            randomBetween(-1.5, 1.5)
        );

        var newClose = correctFloat(
            Math.max(
                1,
                currentCandle.close + movement
            )
        );

        return {
            x: currentCandle.x,
            open: currentCandle.open,
            high: correctFloat(
                Math.max(
                    currentCandle.high,
                    newClose
                )
            ),
            low: correctFloat(
                Math.min(
                    currentCandle.low,
                    newClose
                )
            ),
            close: newClose,
            volume:
                currentCandle.volume +
                Math.round(
                    randomBetween(10, 100)
                )
        };
    }

    /**
     * Creates a new one-minute candle whose opening price
     * matches the previous candle's closing price.
     */
    function createNewCandle(previousCandle) {
        var openingPrice =
            previousCandle.close;

        return {
            x: new Date(
                previousCandle.x.getTime() +
                ONE_MINUTE_MS
            ),
            open: openingPrice,
            high: openingPrice,
            low: openingPrice,
            close: openingPrice,
            volume: Math.round(
                randomBetween(1000, 5000)
            )
        };
    }

    /**
     * Updates the currently forming candle using setData.
     */
    function updateCurrentPoint(candle) {
        var series = getCandleSeries();

        if (!series) {
            return;
        }

        series.setData(
            candle,
            UPDATE_ANIMATION_DURATION
        );
    }

    /**
     * Adds a new candle using addPoint.
     */
    function addNewPoint(candle) {
        var series = getCandleSeries();

        if (!series) {
            return;
        }

        series.addPoint(
            candle,
            ADD_ANIMATION_DURATION
        );
    }

    /**
     * Updates the current candle or appends a new candle.
     */
    function processDynamicUpdate() {
        if (!stockData.length) {
            return;
        }

        var lastIndex =
            stockData.length - 1;

        var currentCandle =
            stockData[lastIndex];

        var shouldAddNewCandle =
            updateIndex > 0 &&
            updateIndex % UPDATES_PER_CANDLE === 0;

        if (shouldAddNewCandle) {
            var newCandle =
                createNewCandle(currentCandle);

            stockData.push(newCandle);
            addNewPoint(newCandle);
        } else {
            var updatedCandle =
                createUpdatedCandle(currentCandle);

            stockData[lastIndex] =
                updatedCandle;

            updateCurrentPoint(
                updatedCandle
            );
        }

        updateIndex++;
    }

    /**
     * Starts the live-update timer.
     */
    function startDynamicUpdates() {
        if (updateTimer !== null) {
            return;
        }

        updateTimer = window.setInterval(
            processDynamicUpdate,
            UPDATE_INTERVAL_MS
        );
    }

    /**
     * Stops the live-update timer.
     */
    function stopDynamicUpdates() {
        if (updateTimer !== null) {
            window.clearInterval(
                updateTimer
            );

            updateTimer = null;
        }
    }

    /**
     * Configures the locally generated data and Last Value Label
     * before the Stock Chart is rendered.
     */
    function stockLoad(args) {
        stockChart = args.stockChart;

        if (
            !stockChart ||
            !stockChart.series ||
            !stockChart.series.length
        ) {
            return;
        }

        stockChart.series[0].dataSource =
            stockData;

        stockChart.series[0].lastValueLabel = {
            enable: true,
            background: '#e74c3d',
            dashArray: '3,2',
            lineWidth: 1,
            font: {
                color: '#ffffff',
                size: '11px'
            }
        };
    }

    /**
     * Starts live updates after the Stock Chart has loaded.
     */
    function stockLoaded(args) {
        stockChart =
            args && args.stockChart
                ? args.stockChart
                : stockChart;

        /*
         * Retrieve the component instance from the rendered
         * element if it is unavailable in the event arguments.
         */
        if (!stockChart) {
            var chartElement =
                document.getElementById('container');

            if (
                chartElement &&
                chartElement.ej2_instances &&
                chartElement.ej2_instances.length
            ) {
                stockChart =
                    chartElement.ej2_instances[0];
            }
        }

        startDynamicUpdates();
    }

    /*
     * Generate the data before the Stock Chart's load event executes.
     */
    createInitialLocalData();

    /**
     * Clears the update timer when the page is unloaded.
     */
    window.addEventListener(
        'beforeunload',
        function () {
            stopDynamicUpdates();
        }
    );
</script>