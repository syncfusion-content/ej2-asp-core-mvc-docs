@Html.EJS().Button("button").Content("Set Null value to property").Render()
@Html.EJS().DropDownList("games").Placeholder("Select a game").PopupHeight("220px").DataSource((IEnumerable<object>)ViewBag.data).Render()

<script>
    document.getElementById('button').onclick = () => {
        var dropObj = document.getElementById("games"); //to get dropdown list object
        dropObj.value = null;
    };
</script>