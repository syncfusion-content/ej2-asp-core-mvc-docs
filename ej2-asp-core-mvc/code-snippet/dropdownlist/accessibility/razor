<div class="control-wrapper">
    <div id="default" style='padding-top:75px;margin:0 auto;width:250px;'>
        @Html.EJS().DropDownList("games").Placeholder("Select a game").PopupHeight("220px").DataSource((IEnumerable<object>)ViewBag.data).Render()
    </div>
</div>
<script>
    document.onkeyup = function (e) {
        if (e.altKey && e.keyCode === 84 /* t */) {
            var dropObj = document.getElementById("games"); //to get dropdown list object
            dropObj.ej2_instances[0].focusIn(); // call the focusIn method to focus the element.
        }
    };
</script>
