@{
    var smartLabelBorder = new
    {
        color = "yellow",
        dashArray = "2",
        width = 2
    };

    var connectorLineStyle = new
    {
        color = "RED",
        width = 2
    };

    var franceSmartLabelSettings = new
    {
        background = "green",
        border = smartLabelBorder,
        connectorLineStyle = connectorLineStyle,
        pointerShape = "Arrow",
        offset = 0.2
    };

    var italySmartLabelSettings = new
    {
        background = "green",
        border = smartLabelBorder,
        connectorLineStyle = connectorLineStyle,
        pointerShape = "Arrow",
        offset = 0.8
    };
}

<ejs-chart3d id="container" title="Mobile Game Market by Country">
    <e-chart3d-primaryxaxis title="Years" interval="1" valueType="@Syncfusion.EJ2.Charts.ValueType.Category">
    </e-chart3d-primaryxaxis>

    <e-chart3d-primaryyaxis title="Sales in Billions" labelFormat="{value}B">
    </e-chart3d-primaryyaxis>

    <e-chart3d-legendsettings visible="true">
    </e-chart3d-legendsettings>

    <e-chart3d-series-collection>
        <e-chart3d-series dataSource="ViewBag.dataSource" xName="x" yName="y" name="UK" type="@Syncfusion.EJ2.Charts.Chart3DSeriesType.StackingColumn" columnWidth="0.5">
            <e-chart3d-series-animation enable="false">
            </e-chart3d-series-animation>

            <e-chart3d-series-datalabel visible="true" labelIntersectAction="@Syncfusion.EJ2.Charts.Chart3DDataLabelIntersectAction.RelocateVertically">
            </e-chart3d-series-datalabel>
        </e-chart3d-series>

        <e-chart3d-series dataSource="ViewBag.dataSource" xName="x" yName="y1" name="Germany" type="@Syncfusion.EJ2.Charts.Chart3DSeriesType.StackingColumn" columnWidth="0.5">
            <e-chart3d-series-animation enable="false">
            </e-chart3d-series-animation>

            <e-chart3d-series-datalabel visible="true" labelIntersectAction="@Syncfusion.EJ2.Charts.Chart3DDataLabelIntersectAction.RelocateVertically">
            </e-chart3d-series-datalabel>
        </e-chart3d-series>

        <e-chart3d-series dataSource="ViewBag.dataSource" xName="x" yName="y2" name="France" type="@Syncfusion.EJ2.Charts.Chart3DSeriesType.StackingColumn" columnWidth="0.5">
            <e-chart3d-series-animation enable="false">
            </e-chart3d-series-animation>

            <e-chart3d-series-datalabel visible="true" labelIntersectAction="@Syncfusion.EJ2.Charts.Chart3DDataLabelIntersectAction.RelocateVertically" smartLabelSettings="franceSmartLabelSettings">
            </e-chart3d-series-datalabel>
        </e-chart3d-series>

        <e-chart3d-series dataSource="ViewBag.dataSource" xName="x" yName="y3" name="Italy" type="@Syncfusion.EJ2.Charts.Chart3DSeriesType.StackingColumn" columnWidth="0.5">
            <e-chart3d-series-animation enable="false">
            </e-chart3d-series-animation>

            <e-chart3d-series-datalabel visible="true" labelIntersectAction="@Syncfusion.EJ2.Charts.Chart3DDataLabelIntersectAction.RelocateVertically" smartLabelSettings="italySmartLabelSettings">
            </e-chart3d-series-datalabel>
        </e-chart3d-series>
    </e-chart3d-series-collection>
</ejs-chart3d>